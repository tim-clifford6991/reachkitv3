# .env.example — every binding BUILD.md §15 names, plus HOSTED_EDGE_CNAME_TARGET
# (BP-005's `Env` note). Names only; every value is blank. A real credential
# here is a defect (WO-001 file plan).
#
# BP-005 decision 6 rebinds three of §15's rows to the deployment target
# (the existing Vercel project `reachkit`, whose secrets are write-only):
# SUPABASE_SERVICE_ROLE is retired in favour of SUPABASE_SERVICE_ROLE_KEY
# below (6a); NANO_API_KEY is optional and resolves to ANTHROPIC_API_KEY
# when absent (6b); DATABASE_URL is not a member of `Env` — it is the
# migration and test tooling's binding, recorded below, not lost (6c).

# Supabase (BP-002)
# DATABASE_URL is the migration and test tooling's binding (BP-005
# decision 6c) — not a member of `Env`; no module under src/ reads it.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (BP-017)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Resend (BP-016)
RESEND_API_KEY=

# DataForSEO (BP-008)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Inference (BP-009)
ANTHROPIC_API_KEY=
# NANO_API_KEY is optional (BP-005 decision 6b) — absent, it resolves to
# ANTHROPIC_API_KEY.
NANO_API_KEY=

# Compliance / operations (BP-005, BUILD.md §14)
IP_HASH_SALT=
KILL_SWITCH=
OWNER_EMAILS=

# App
NEXT_PUBLIC_APP_URL=

# Hosted content edge (BP-004, BP-005's `Env` note)
HOSTED_EDGE_CNAME_TARGET=
