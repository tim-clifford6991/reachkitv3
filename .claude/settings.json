{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/plugins/sdlc-factory/hooks/route-prompt.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/plugins/sdlc-factory/hooks/guard-corpus-write.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sdlc-factory@timclifford": false
  },
  "env": {
    "SDLC_FACTORY_GUARD": "off"
  }
}
